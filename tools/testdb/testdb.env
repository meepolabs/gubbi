# Pinned images for the test database stack, shared by CI and local runs.
#
# Strict format, enforced by every reader: the file is ASCII-only with LF line
# endings and no control characters other than the LF terminator, comments
# included. Each line is a comment (#...), blank, or KEY=value fully matching
# ^[A-Z][A-Z0-9_]*=[!-~]+$ -- printable ASCII, no spaces, no empty values.
# Anything else is a hard error.
#
# PG_MAJOR is the PostgreSQL major PGVECTOR_IMAGE provides. A digest carries no
# readable version, so bump both together.

PGVECTOR_IMAGE=pgvector/pgvector@sha256:cf134a767f474095eeba57e0117be8e568e011a63f33fbf252f14c9b760f8e6f
PG_MAJOR=17
REDIS_IMAGE=redis:7-alpine@sha256:858f009f9709ce576febc734aa78b8f6d624b82571f9ddb6bda4377c833b3499
