#!/usr/bin/env bash
# psql from the pinned PGVECTOR_IMAGE in testdb.env, run in a throwaway docker
# container, for machines without a host psql of PG_MAJOR. `testdb.py psql-path`
# decides whether this directory belongs on PATH.
#
# The container shares the host network, so 127.0.0.1 DSNs work unchanged. The
# git toplevel of the working directory and the temp dir are mounted read-only
# at their host paths and the working directory is kept, so relative and
# absolute -f / \i paths under either resolve. stdin is passed through.
set -euo pipefail

bin_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
testdb_py="$bin_dir/../testdb.py"

# check-env is the one testdb.env validator and names the file on failure. Its
# output may hold shell metacharacters, so the key is matched by name, never
# eval'd or sourced.
if ! pins=$(python3 -I "$testdb_py" check-env); then
    echo "psql wrapper: cannot read PGVECTOR_IMAGE from testdb.env" >&2
    exit 2
fi
image=""
while IFS= read -r line; do
    case $line in
        PGVECTOR_IMAGE=*) image=${line#PGVECTOR_IMAGE=} ;;
    esac
done <<<"$pins"
if [[ -z $image ]]; then
    echo "psql wrapper: testdb.env does not declare PGVECTOR_IMAGE" >&2
    exit 2
fi

tmp_dir=$(cd -- "${TMPDIR:-/tmp}" && pwd -P)
mounts=(--volume "$tmp_dir:$tmp_dir:ro")
if toplevel=$(git rev-parse --show-toplevel 2>/dev/null) && [[ $toplevel != "$tmp_dir" ]]; then
    mounts+=(--volume "$toplevel:$toplevel:ro")
fi

# libpq reads PG*; bootstrap.sql reads its role passwords with \getenv. The
# ${a[@]+...} expansions keep empty arrays safe under set -u on bash < 4.4.
env_args=()
while IFS= read -r name; do
    case $name in
        PG* | JOURNAL_DB_*) env_args+=(--env "$name") ;;
    esac
done < <(compgen -e)

tty_args=()
if [[ -t 0 && -t 1 ]]; then
    tty_args=(--tty)
fi

exec docker run --rm --interactive --quiet --network host \
    ${tty_args[@]+"${tty_args[@]}"} ${env_args[@]+"${env_args[@]}"} \
    "${mounts[@]}" --workdir "$PWD" \
    -- "$image" psql "$@"
