#!/usr/bin/env bash
# psql for machines without a host psql of PG_MAJOR. `testdb.py psql-path`
# decides whether this directory belongs on PATH; `testdb.py psql-plan` decides,
# per command line, which of two ways it runs (see psql-plan in testdb.py).
#
# exec: the command targets a port published by this checkout's own running pg
# container, so psql runs inside that container with `docker exec`, as an
# unprivileged user and with no mounts. The plan rewrites the target to the
# container's own network address on port 5432 and turns one -f PATH (a file
# under deployment/scripts or tools/testdb) into -f - with PATH on stdin.
#
# run: anything else runs unchanged in a throwaway container of the pinned
# PGVECTOR_IMAGE on the host network, so 127.0.0.1 DSNs work as they are.
# Mounted, read-only and at their host paths: only this repository's SQL input
# directories, deployment/scripts and tools/testdb, located from this script
# rather than from git so they hold even outside a checkout. Nothing else is
# mounted -- not the checkout root, the temp dir or $HOME -- because the client
# needs only these SQL files and the rest of the tree holds ignored local
# credentials. The working directory is kept, so relative and absolute -f / \i
# paths into those directories resolve from the repo root or any directory
# beneath it; any other file path is not found. stdin and -c are passed through.
set -euo pipefail

bin_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
testdb_py="$bin_dir/../testdb.py"

# NUL-separated fields ending in "end"; a missing terminator means the planner
# failed (it has already named the problem on stderr). `read -d ''` rather than
# mapfile keeps this working on bash 3.2. The planner gets no stdin: it is psql's.
plan=()
while IFS= read -r -d '' field; do
    plan+=("$field")
done < <(python3 -I "$testdb_py" psql-plan "$@" </dev/null)
count=${#plan[@]}
if ((count < 3)) || [[ ${plan[count - 1]} != end ]]; then
    echo "psql wrapper: testdb.py psql-plan failed; see its message above" >&2
    exit 2
fi
mode=${plan[0]}
target=${plan[1]}

# libpq reads PG*; bootstrap.sql reads its role passwords with \getenv. The
# ${a[@]+...} expansions keep empty arrays safe under set -u on bash < 4.4.
env_args=()
while IFS= read -r name; do
    case $name in
        PG* | JOURNAL_DB_*) env_args+=(--env "$name") ;;
    esac
done < <(compgen -e)

tty_args=()
if [[ -t 0 && -t 1 ]]; then
    tty_args=(--tty)
fi

case $mode in
    exec)
        stdin_file=${plan[2]}
        psql_args=("${plan[@]:3:count-4}")
        if [[ -n $stdin_file ]]; then
            exec docker exec --interactive --user 65534:65534 \
                ${env_args[@]+"${env_args[@]}"} \
                -- "$target" psql ${psql_args[@]+"${psql_args[@]}"} <"$stdin_file"
        fi
        exec docker exec --interactive --user 65534:65534 \
            ${tty_args[@]+"${tty_args[@]}"} ${env_args[@]+"${env_args[@]}"} \
            -- "$target" psql ${psql_args[@]+"${psql_args[@]}"}
        ;;
    run) ;;
    *)
        echo "psql wrapper: unknown psql-plan mode: $mode" >&2
        exit 2
        ;;
esac

# A missing host dir is skipped: docker would create it, root-owned, on the host.
repo_root=$(cd -- "$bin_dir/../../.." && pwd -P)
mounts=()
for sql_dir in "$repo_root/deployment/scripts" "$repo_root/tools/testdb"; do
    if [[ -d $sql_dir ]]; then
        mounts+=(--volume "$sql_dir:$sql_dir:ro")
    fi
done

exec docker run --rm --interactive --quiet --network host \
    ${tty_args[@]+"${tty_args[@]}"} ${env_args[@]+"${env_args[@]}"} \
    ${mounts[@]+"${mounts[@]}"} --workdir "$PWD" \
    -- "$target" psql "$@"
